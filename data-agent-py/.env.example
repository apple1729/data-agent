# 复制成 .env 后按需修改。所有项都有默认值，不配也能跑阶段 0。

# ---- 服务本身 ----
APP_HOST=0.0.0.0
APP_PORT=9933

# ---- A2A 名片 ----
# 这是「客户端来调我」的地址，不是「我监听」的地址。
# 默认走 Vite 的 /api 代理（3500 → 9933），和 Java 版名片保持一致，
# 这样前端一行都不用改。
AGENT_URL=http://localhost:3500/api/a2a/jsonrpc
AGENT_NAME=sqlAgent
AGENT_DESCRIPTION=专业的SQL生成Agent
AGENT_VERSION=1.0

# ---- PostgreSQL（阶段 1 才会用到）----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=data_agent
PG_USER=postgres
PG_PASSWORD=postgres

# ---- 大模型 / 向量（阶段 3 才会用到）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=deepseek-v4-pro
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
